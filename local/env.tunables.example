# Настраиваемые параметры рантайма. Не секреты — можно коммитить
# локальные дефолты, если нужно. Приложение применяет приоритет
# env → (раньше был TOML) → default-в-коде; здесь значения нужны,
# только если нужно перебить код-дефолт.

# Опциональные sampling-дефолты (пусто = chainlit/агент выбирают сами):
# LLM_TEMPERATURE=0.7
# LLM_TOP_P=0.95
# LLM_MAX_TOKENS=4096
# LLM_PARALLEL_TOOL_CALLS=false

# ---------- Agent loop ----------
# AGENT_MAX_ITERATIONS=20
# AGENT_MAX_CONSECUTIVE_TOOL_CALLS=3
# AGENT_MAX_CONSECUTIVE_FORMAT_FAILURES=3

# ---------- Приложение ----------
# SSL_VERIFY=false
# LOG_LEVEL=INFO
LOG_FILE=/app/logs/chainlit.log

# ---------- Workspaces (bind-mount в compose к volume /app/workspaces) ----------
WORKSPACE_BASE_DIR=/app/workspaces

# ---------- Chainlit webserver ----------
CHAINLIT_HOST=0.0.0.0
CHAINLIT_PORT=8501
CHAINLIT_ROOT_PATH=/boba
CHAINLIT_HEADLESS=true

# Список моделей для ChatSettings (CSV). Непустой — пользователь выбирает.
CHAINLIT_MODELS=qwen3,qwen3-0.6b,qwen3-235b,qwen3.5-35b,qwen3.5-122b,deepseek-coder-v2-16b,qwen2.5-coder-1.5b,llama3.1-8b,gemini,numarkdown-q4,numarkdown-q8
