# Шаблон для docker-compose deployment'а — только URL'ы и секреты.
# Всё остальное (log_level, agent loop, chainlit-server, paths и т.п.)
# лежит в config.toml — см. local/config.toml.example.
#
# Копировать в ``boba-artifacts/local/.env`` и заполнить реальными
# значениями. Сам .env gitignored (см. .gitignore: ``local/*``);
# трекается только этот шаблон.
#
# Используется docker-compose.yml: ``env_file: ./local/.env``.
# Локальные dev-значения (для VSCode launch.json) живут отдельно в
# ../boba/local/.env — тот же набор ключей, dev-хосты/секреты.
#
# Имена ключей задаются единым алгоритмом в boba-config-env:
#   ConfigKey(parts...) -> "BOBA_" + "_".join(parts).upper()
# (см. packages/boba-config-env/src/boba_config_env/_source.py).

# Путь до TOML-конфига внутри контейнера. ConfigBundle читает
# именно его (см. boba-config-toml: TomlFileSource/CONFIG_PATH_ENV).
BOBA_CONFIG_PATH=/app/local/config.toml

# ---------- LLM (litellm-proxy в той же docker network) ----------
BOBA_LLM_BASE_URL=http://litellm:4000
BOBA_LLM_API_KEY=sk-REPLACE-WITH-LITELLM-API-KEY

# JWT-секрет chainlit. Генерация: ``openssl rand -hex 32``.
BOBA_CHAINLIT_AUTH_SECRET=replace-me-with-openssl-rand-hex-32
