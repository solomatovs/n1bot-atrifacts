# ============================================================
# Пример nginx location-блока для проксирования chainlit.
# Подключается в http-server блок:
#   include /etc/nginx/conf.d/locations/nginx-boba.conf;
#
# Требования:
#   1. nginx-контейнер и boba-chainlit — в одной docker network
#      (по умолчанию "docker"). DNS-резолв хоста `boba-chainlit`
#      делает встроенный Docker DNS по 127.0.0.11.
#   2. CHAINLIT_ROOT_PATH в local/env.tunables должен совпадать с
#      префиксом location'а (по умолчанию /boba).
#
# Публичный URL: https://<host>/boba/
# ============================================================

# WebSocket для live-сообщений chainlit (socketio). Должен идти ДО
# catch-all `location /boba/` — nginx матчит самый длинный префикс.
location /boba/ws/ {
  resolver 127.0.0.11 valid=5s;
  set $chainlit http://127.0.0.1:8501;
  proxy_pass $chainlit;

  proxy_http_version 1.1;
  proxy_buffering    off;
  proxy_cache_bypass $http_upgrade;

  proxy_set_header Upgrade           $http_upgrade;
  proxy_set_header Connection        "upgrade";
  proxy_set_header Host              $http_host;
  proxy_set_header X-Real-IP         $remote_addr;
  proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Forwarded-Host  $http_host;
  proxy_set_header X-Forwarded-Port  $server_port;

  # WS-коннекты живут долго — даём сутки, чтобы idle не рвал сессию.
  proxy_read_timeout 86400s;
}

# Всё остальное (HTML/JS, /boba/healthz, /boba/login и пр.).
location /boba/ {
  resolver 127.0.0.11 valid=5s;
  set $chainlit http://127.0.0.1:8501;
  proxy_pass $chainlit;

  proxy_http_version 1.1;
  proxy_buffering    off;
  proxy_cache_bypass $http_upgrade;

  proxy_set_header Upgrade           $http_upgrade;
  proxy_set_header Connection        "upgrade";
  proxy_set_header Host              $http_host;
  proxy_set_header X-Real-IP         $remote_addr;
  proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Forwarded-Host  $http_host;
  proxy_set_header X-Forwarded-Port  $server_port;
}
