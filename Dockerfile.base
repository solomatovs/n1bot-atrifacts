# Dockerfile.base — сборка glibc 2.28 + GCC 8 + Python 3.11

FROM astra_linux_ce_2.12-rootfs:latest AS builder

ARG GLIBC_VERSION=2.28
ARG GCC_VERSION=8.5.0
ARG PYTHON_VERSION=3.11.12

# apt: доверять неподписанным репо (закрытый контур)
RUN printf '%s\n' \
      'APT::Get::AllowUnauthenticated "true";' \
      'Acquire::AllowInsecureRepositories "true";' \
      'Acquire::AllowDowngradeToInsecureRepositories "true";' \
      > /etc/apt/apt.conf.d/99insecure

# override sources.list
COPY local/apt-sources.list* /tmp/aptsrc/
RUN if [ -f /tmp/aptsrc/apt-sources.list ] && \
       grep -qvE '^[[:space:]]*(#|$)' /tmp/aptsrc/apt-sources.list; then \
      cp /tmp/aptsrc/apt-sources.list /etc/apt/sources.list; \
    fi && rm -rf /tmp/aptsrc

# корпоративные CA
COPY local/ca-chain.crt* /tmp/cacrt/
RUN if [ -f /tmp/cacrt/ca-chain.crt ] && \
       grep -qE '^-----BEGIN CERTIFICATE-----' /tmp/cacrt/ca-chain.crt; then \
      cp /tmp/cacrt/ca-chain.crt /usr/local/share/ca-certificates/ca-chain.crt && \
      update-ca-certificates; \
    fi && rm -rf /tmp/cacrt

# build-toolchain
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential gawk bison xz-utils \
        zlib1g-dev libncurses5-dev libgdbm-dev libnss3-dev \
        libssl-dev libreadline-dev libffi-dev libsqlite3-dev \
        libbz2-dev liblzma-dev curl \
    && rm -rf /var/lib/apt/lists/*

# glibc 2.28
COPY glibc-src/glibc-${GLIBC_VERSION}.tar.xz /tmp/glibc.tar.xz
RUN cd /tmp && \
    tar -xf glibc.tar.xz && \
    mkdir glibc-build && cd glibc-build && \
    ../glibc-${GLIBC_VERSION}/configure \
        --prefix=/opt/glibc-2.28 \
        --disable-werror \
        --enable-kernel=4.15 && \
    make -j"$(nproc)" && make install && \
    rm -rf /tmp/glibc*

RUN mkdir -p /opt/glibc-2.28/etc && \
    printf '/lib/x86_64-linux-gnu\n/usr/lib/x86_64-linux-gnu\n/usr/lib\n/lib\n' \
        > /opt/glibc-2.28/etc/ld.so.conf && \
    /opt/glibc-2.28/sbin/ldconfig

RUN ln -sf /opt/glibc-2.28/lib/ld-linux-x86-64.so.2 /lib64/ld-linux-x86-64.so.2

# GCC 8 (libstdc++)
COPY gcc-src/ /tmp/gcc-src/
RUN cd /tmp && \
    tar -xf gcc-src/gcc-${GCC_VERSION}.tar.xz && \
    cd gcc-${GCC_VERSION} && \
    tar -xf /tmp/gcc-src/gmp-6.1.2.tar.xz && mv gmp-6.1.2 gmp && \
    tar -xf /tmp/gcc-src/mpfr-4.0.2.tar.xz && mv mpfr-4.0.2 mpfr && \
    tar -xf /tmp/gcc-src/mpc-1.1.0.tar.gz && mv mpc-1.1.0 mpc && \
    cd /tmp && mkdir gcc-build && cd gcc-build && \
    ../gcc-${GCC_VERSION}/configure \
        --prefix=/opt/gcc-8 \
        --enable-languages=c,c++ \
        --disable-multilib --disable-bootstrap \
        --disable-libsanitizer --disable-libgomp \
        --disable-libquadmath --disable-libssp \
        --disable-libvtv --disable-libada \
        --with-default-libstdcxx-abi=new && \
    make -j"$(nproc)" && make install-strip && \
    rm -rf /tmp/gcc* /tmp/gcc-src

# Python 3.11
COPY python-src/Python-${PYTHON_VERSION}.tar.xz /tmp/Python.tar.xz
RUN cd /tmp && \
    tar -xf Python.tar.xz && \
    cd Python-${PYTHON_VERSION} && \
    ./configure \
        --prefix=/opt/python3.11 \
        --enable-optimizations --with-lto \
        --with-ensurepip=install && \
    make -j"$(nproc)" && make install && \
    rm -rf /tmp/Python*

# чистый runtime
FROM astra_linux_ce_2.12-rootfs:latest

# apt insecure + sources.list + CA
RUN printf '%s\n' \
      'APT::Get::AllowUnauthenticated "true";' \
      'Acquire::AllowInsecureRepositories "true";' \
      'Acquire::AllowDowngradeToInsecureRepositories "true";' \
      > /etc/apt/apt.conf.d/99insecure

COPY local/apt-sources.list* /tmp/aptsrc/
RUN if [ -f /tmp/aptsrc/apt-sources.list ] && \
       grep -qvE '^[[:space:]]*(#|$)' /tmp/aptsrc/apt-sources.list; then \
      cp /tmp/aptsrc/apt-sources.list /etc/apt/sources.list; \
    fi && rm -rf /tmp/aptsrc

COPY local/ca-chain.crt* /tmp/cacrt/
RUN if [ -f /tmp/cacrt/ca-chain.crt ] && \
       grep -qE '^-----BEGIN CERTIFICATE-----' /tmp/cacrt/ca-chain.crt; then \
      cp /tmp/cacrt/ca-chain.crt /usr/local/share/ca-certificates/ca-chain.crt && \
      update-ca-certificates; \
    fi && rm -rf /tmp/cacrt

# Runtime-зависимости
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libssl1.1 libffi6 libsqlite3-0 libbz2-1.0 \
        liblzma5 libreadline7 libncurses5 zlib1g curl \
        imagemagick \
        libreoffice-writer libreoffice-calc libreoffice-impress \
        ghostscript \
        fonts-dejavu-core \
        bubblewrap \
        git \
    && rm -rf /var/lib/apt/lists/*

# снять Debian-запрет PDF-coder в ImageMagick (иначе img-PDF = "not authorized")
RUN for p in /etc/ImageMagick-6/policy.xml /etc/ImageMagick-7/policy.xml; do \
      if [ -f "$p" ]; then \
        sed -i 's#rights="none" pattern="PDF"#rights="read|write" pattern="PDF"#' "$p"; \
      fi; \
    done

# liteparse ждёт унифицированный CLI magick (ImageMagick 7)
# Astra/Debian даёт IM6 только с CLI convert.
RUN printf '%s\n' \
      '#!/bin/sh' \
      'case "$1" in' \
      '  convert|identify|mogrify|composite|montage|compare|stream|conjure|import) c="$1"; shift; exec "$c" "$@";;' \
      '  *) exec convert "$@";;' \
      'esac' \
      > /usr/local/bin/magick && chmod +x /usr/local/bin/magick

# для разных программ свои переменные окружения CA bundle
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    PIP_CERT=/etc/ssl/certs/ca-certificates.crt \
    CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    GIT_SSL_CAINFO=/etc/ssl/certs/ca-certificates.crt

COPY --from=builder /opt/glibc-2.28 /opt/glibc-2.28
RUN ln -sf /opt/glibc-2.28/lib/ld-linux-x86-64.so.2 /lib64/ld-linux-x86-64.so.2 && \
    ln -sf /opt/glibc-2.28/lib/libc.so.6 /lib/x86_64-linux-gnu/libc.so.6

COPY --from=builder /opt/gcc-8/lib64/libstdc++.so.6* /usr/lib/x86_64-linux-gnu/
COPY --from=builder /opt/gcc-8/lib64/libgcc_s.so.1  /lib/x86_64-linux-gnu/libgcc_s.so.1
RUN /opt/glibc-2.28/sbin/ldconfig

COPY --from=builder /opt/python3.11 /opt/python3.11
ENV PATH="/opt/python3.11/bin:${PATH}"

RUN python3 --version && pip3 --version
