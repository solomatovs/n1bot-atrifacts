# Настройки сервера
litellm_settings:
  # Глобальная настройка для отбрасывания неподдерживаемых параметров
  drop_params: true
  
  # Порт для API
  port: 4000
  
  # Логирование
  set_verbose: true
  
  # CORS для веб-приложений
  cors: true
  # Специально для vision моделей
  supports_vision: true
  enable_multimodal: true

router_settings:
  enable_pre_call_checks: true

# Дополнительные настройки
general_settings:
  # Таймауты
  request_timeout: 600
